{
  "name": "help-note-desktop",
  "version": "1.1.0",
  "description": "빼꼼 - 늘 맨 위에 떠 있는 수업 메모지",
  "author": "help-note",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "io.github.yys10413400.helpnote",
    "productName": "빼꼼",
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "icon.png"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "help-note.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
